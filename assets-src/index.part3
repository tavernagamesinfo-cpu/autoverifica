"del">✕</button>';card.append(c,meta,note,mini);g.appendChild(card);try{const src=await imageToCanvas(it,1200),sp=pageSpec(src.width,src.height),fit=placement(src.width,src.height,sp.w,sp.h,sp.m,$('#imgFit').value),sc=260/sp.w;c.width=260;c.height=Math.round(sp.h*sc);const ctx=c.getContext('2d');ctx.fillStyle='#fff';ctx.fillRect(0,0,c.width,c.height);ctx.save();ctx.beginPath();ctx.rect(0,0,c.width,c.height);ctx.clip();ctx.drawImage(src,fit.x*sc,(sp.h-fit.y-fit.h)*sc,fit.w*sc,fit.h*sc);ctx.restore();note.className=fit.crop?'crop':'safe';note.textContent=tr(fit.crop?'will_crop':'whole_image')}catch(err){note.className='crop';note.textContent=err.message}meta.className='meta';meta.textContent=(i+1)+'. '+it.file.name;mini.querySelector('[data-a=up]').onclick=()=>move(imgs,i,-1,renderImgPreviews);mini.querySelector('[data-a=down]').onclick=()=>move(imgs,i,1,renderImgPreviews);mini.querySelector('[data-a=l]').onclick=()=>{it.rot=(it.rot+270)%360;renderImgPreviews()};mini.querySelector('[data-a=r]').onclick=()=>{it.rot=(it.rot+90)%360;renderImgPreviews()};mini.querySelector('[data-a=del]').onclick=()=>{imgs.splice(i,1);renderImgPreviews()}}status('#imgStatus',tr('preview_ready'),'ok')}
$('#makeImgPdf').onclick=async()=>{if(!imgs.length)return status('#imgStatus',tr('select_image'),'err');try{status('#imgStatus',tr('working'),'info');const out=await PDFLib.PDFDocument.create(),q=+$('#imgQ').value/100;for(let i=0;i<imgs.length;i++){status('#imgStatus',`${tr('working')} ${i+1}/${imgs.length}`,'info');const c=await imageToCanvas(imgs[i],3000),blob=await canvasBlob(c,'image/jpeg',q),bytes=new Uint8Array(await blob.arrayBuffer()),emb=await out.embedJpg(bytes),sp=pageSpec(c.width,c.height),fit=placement(c.width,c.height,sp.w,sp.h,sp.m,$('#imgFit').value),p=out.addPage([sp.w,sp.h]);p.drawImage(emb,{x:fit.x,y:fit.y,width:fit.w,height:fit.h})}const bytes=await out.save({useObjectStreams:true});download(bytes,LANG==='it'?'foto.pdf':'images.pdf','application/pdf');status('#imgStatus',tr('created'),'ok')}catch(err){console.error(err);status('#imgStatus',tr('error')+': '+(err.message||err),'err')}};

let pdfImgFile=null,pdfImgDoc=null;$('#pdfImgInput').onchange=async e=>{pdfImgFile=e.target.files[0]||null;pdfImgDoc=null;$('#pdfImgPreview').innerHTML='';$('#pdfImgInfo').style.display='none';if(!pdfImgFile)return;try{status('#pdfImgStatus',tr('loading'),'info');pdfImgDoc=await loadPdfJS(pdfImgFile);$('#pdfImgInfo').style.display='block';$('#pdfImgInfo').textContent=`${pdfImgFile.name} • ${fmt(pdfImgFile.size)} • ${pdfImgDoc.numPages} ${tr('pages')}`;const c=document.createElement('canvas'),card=document.createElement('div');card.className='pageCard';await renderPage(pdfImgDoc,1,c,.45);card.appendChild(c);const m=document.createElement('div');m.className='meta';m.textContent=`1 / ${pdfImgDoc.numPages}`;card.appendChild(m);$('#pdfImgPreview').appendChild(card);status('#pdfImgStatus',tr('file_selected'),'ok')}catch(err){console.error(err);pdfImgDoc=null;status('#pdfImgStatus',tr('invalid_pdf')+'\n'+(err.message||err),'err')}};$('#pdfQ').oninput=e=>$('#pdfQVal').textContent=e.target.value+'%';
$('#exportImgs').onclick=async()=>{if(!pdfImgFile)return status('#pdfImgStatus',tr('select_pdf'),'err');try{const pdf=pdfImgDoc||await loadPdfJS(pdfImgFile),zip=new JSZip(),scale=+$('#pdfScale').value,q=+$('#pdfQ').value/100;for(let i=1;i<=pdf.numPages;i++){status('#pdfImgStatus',`${tr('working')} ${i}/${pdf.numPages}`,'info');const c=document.createElement('canvas');await renderPage(pdf,i,c,scale);zip.file(`page-${String(i).padStart(3,'0')}.jpg`,await canvasBlob(c,'image/jpeg',q))}const blob=await zip.generateAsync({type:'blob',compression:'DEFLATE',compressionOptions:{level:6}});download(blob,basename(pdfImgFile.name)+(LANG==='it'?'-immagini.zip':'-images.zip'),'application/zip');status('#pdfImgStatus',`${tr('exported')}: ${pdf.numPages}`,'ok')}catch(err){console.error(err);status('#pdfImgStatus',tr('error')+': '+(err.message||err),'err')}};

let mergeFiles=[];$('#mergeInput').onchange=e=>{mergeFiles.push(...e.target.files);e.target.value='';renderMerge()};function renderMerge(){const g=$('#mergeList');g.innerHTML='';mergeFiles.forEach((f,i)=>{const r=document.createElement('div');r.className='fileRow';r.innerHTML=`<span>📄</span><span class="name"></span><button data-a="up">↑</button><button data-a="down">↓</button><button data-a="del">✕</button>`;r.querySelector('.name').textContent=f.name+' • '+fmt(f.size);r.querySelector('[data-a=up]').onclick=()=>move(mergeFiles,i,-1,renderMerge);r.querySelector('[data-a=down]').onclick=()=>move(mergeFiles,i,1,renderMerge);r.querySelector('[data-a=del]').onclick=()=>{mergeFiles.splice(i,1);renderMerge()};g.appendChild(r)})}$('#mergeClear').onclick=()=>{mergeFiles=[];renderMerge()};$('#mergeBtn').onclick=async()=>{if(mergeFiles.length<2)return status('#mergeStatus',tr('select_two'),'err');try{const out=await PDFLib.PDFDocument.create();for(let i=0;i<mergeFiles.length;i++){status('#mergeStatus',`${tr('working')} ${i+1}/${mergeFiles.length}`,'info');const src=await PDFLib.PDFDocument.load(await mergeFiles[i].arrayBuffer());const ps=await out.copyPages(src,src.getPageIndices());ps.forEach(p=>out.addPage(p))}download(await out.save({useObjectStreams:true}),LANG==='it'?'pdf-uniti.pdf':'merged-pdf.pdf','application/pdf');status('#mergeStatus',tr('created'),'ok')}catch(err){status('#mergeStatus',tr('error')+': '+err.message,'err')}};

let extractFile=null,extractCount=0;$('#extractInput').onchange=async e=>{extractFile=e.target.files[0]||null;if(!extractFile)return;try{const d=await PDFLib.PDFDocument.load(await extractFile.arrayBuffer());extractCount=d.getPageCount();status('#extractStatus',`${extractFile.name} • ${extractCount} ${tr('pages')}`,'ok')}catch(err){extractFile=null;status('#extractStatus',tr('invalid_pdf'),'err')}};function parseSpec(s,max){const out=[];for(const part of s.split(',')){const p=part.trim();if(!p)continue;if(/^\d+$/.test(p)){const n=+p;if(n>=1&&n<=max)out.push(n)}else if(/^\d+\s*-\s*\d+$/.test(p)){let[a,b]=p.split('-').map(x=>+x.trim());if(a>b)[a,b]=[b,a];for(let n=a;n<=b;n++)if(n>=1&&n<=max)out.push(n)}else throw new Error('Invalid range')}return [...new Set(out)]}$('#extractBtn').onclick=async()=>{if(!extractFile)return status('#extractStatus',tr('select_pdf'),'err');try{const nums=parseSpec($('#extractSpec').value,extractCount);if(!nums.length)throw new Error(tr('no_pages'));const src=await PDFLib.PDFDocument.load(await extractFile.arrayBuffer()),out=await PDFLib.PDFDocument.create(),ps=await out.copyPages(src,nums.map(n=>n-1));ps.forEach(p=>out.addPage(p));download(await out.save({useObjectStreams:true}),basename(extractFile.name)+(LANG==='it'?'-estratto.pdf':'-extracted.pdf'),'application/pdf');status('#extractStatus',tr('created'),'ok')}catch(err){status('#extractStatus',tr('error')+': '+err.message,'err')}};

let orgFile=null,orgPdf=null,orgItems=[];$('#orgInput').onchange=async e=>{orgFile=e.target.files[0]||null;$('#orgGrid').innerHTML='';if(!orgFile)return;try{status('#orgStatus',tr('loading'),'info');orgPdf=await loadPdfJS(orgFile);orgItems=Array.from({length:orgPdf.numPages},(_,i)=>({src:i,rot:0}));await renderOrg();status('#orgStatus',`${orgItems.length} ${tr('pages')}`,'ok')}catch(err){status('#orgStatus',tr('invalid_pdf')+' '+err.message,'err')}};async function renderOrg(){const g=$('#orgGrid');g.innerHTML='';for(let i=0;i<orgItems.length;i++){const it=orgItems[i],card=document.createElement('div'),c=document.createElement('canvas'),m=document.createElement('div'),mini=document.createElement('div');card.className='pageCard';await renderPage(orgPdf,it.src+1,c,.35);if(it.rot)c.style.transform=`rotate(${it.rot}deg)`;m.className='meta';m.textContent=`${it.src+1}${it.rot?' • '+it.rot+'°':''}`;mini.className='mini';mini.innerHTML='<button data-a="up">↑</button><button data-a="down">↓</button><button data-a="rot">↻</button><button data-a="del">✕</button>';card.append(c,m,mini);g.appendChild(card);mini.querySelector('[data-a=up]').onclick=()=>move(orgItems,i,-1,renderOrg);mini.querySelector('[data-a=down]').onclick=()=>move(orgItems,i,1,renderOrg);mini.querySelector('[data-a=rot]').onclick=()=>{it.rot=(it.rot+90)%360;renderOrg()};mini.querySelector('[data-a=del]').onclick=()=>{orgItems.splice(i,1);renderOrg()}}}$('#orgSave').onclick=async()=>{if(!orgFile||!orgItems.length)return status('#orgStatus',tr('select_pdf'),'err');try{const src=await PDFLib.PDFDocument.load(await orgFile.arrayBuffer()),out=await PDFLib.PDFDocument.create();for(const it of orgItems){const[p]=await out.copyPages(src,[it.src]);if(it.rot)p.setRotation(PDFLib.degrees(((p.getRotation().angle||0)+it.rot)%360));out.addPage(p)}download(await out.save({useObjectStreams:true}),basename(orgFile.name)+(LANG==='it'?'-organizzato.pdf':'-organized.pdf'),'application/pdf');status('#orgStatus',tr('created'),'ok')}catch(err){status('#orgStatus',tr('error')+': '+err.message,'err')}};

const sigC=$('#sigCanvas'),sigX=sigC.getContext('2d');sigX.lineCap='round';sigX.lineJoin='round';sigX.lineWidth=6;sigX.strokeStyle='#111';
let drawing=false,last=null,signFile=null,signPdf=null,signPlace=null,textFile=null,textPdf=null,textPlace=null,textPageWidth=595;
function clamp01(v){return Math.max(0,Math.min(1,v))}
function pointerNorm(stage,e){const r=stage.getBoundingClientRect();return{x:clamp01((e.clientX-r.left)/r.width),y:clamp01((e.clientY-r.top)/r.height)}}
function pt(e){const r=sigC.getBoundingClientRect();return{x:(e.clientX-r.left)*sigC.width/r.width,y:(e.clientY-r.top)*sigC.height/r.height}}
function s0(e){e.preventDefault();drawing=true;last=pt(e)}
function sm(e){if(!drawing)return;e.preventDefault();const p=pt(e);sigX.beginPath();sigX.moveTo(last.x,last.y);sigX.lineTo(p.x,p.y);sigX.stroke();last=p}
function se(){if(drawing){drawing=false;updateSignOverlay()}}
sigC.addEventListener('pointerdown',s0);sigC.addEventListener('pointermove',sm);sigC.addEventListener('pointerup',se);sigC.addEventListener('pointercancel',se);
functi