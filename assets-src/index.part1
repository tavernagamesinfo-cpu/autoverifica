data-i="quality">Qualità JPG</span> <span id="imgQVal">85%</span></label><input id="imgQ" type="range" min="45" max="98" value="85"></div><button id="safeFit" class="secondary" data-i="safe_all">✓ Adatta tutto senza tagli</button></div>
<div id="imgPreview" class="previewGrid"></div><div class="row"><button id="makeImgPdf" class="primary" data-i="make_pdf">Crea PDF</button><button id="clearImgs" class="secondary" data-i="clear">Svuota</button></div><div id="imgStatus" class="status"></div>
</div></section>

<section class="panel" id="pdf2img"><div class="head"><button class="back">←</button><strong data-i="t_pdf2img">PDF → immagini</strong></div><div class="body">
<div class="drop"><label class="pick"><span data-i="choose_pdf">Scegli PDF</span><input id="pdfImgInput" type="file" accept="application/pdf,.pdf"></label><p class="small" data-i="pdf_load_help">Dopo la selezione devono comparire nome, dimensione e numero di pagine.</p></div>
<div id="pdfImgInfo" class="hint" style="display:none"></div><div id="pdfImgPreview" class="previewGrid"></div>
<div class="row"><div class="field"><label class="cap" data-i="resolution">Risoluzione</label><select id="pdfScale"><option value="1.2" data-i="light">Leggera</option><option value="1.8" selected data-i="good">Buona</option><option value="2.5" data-i="high">Alta</option></select></div><div class="field"><label class="cap"><span data-i="quality">Qualità JPG</span> <span id="pdfQVal">88%</span></label><input id="pdfQ" type="range" min="50" max="98" value="88"></div></div>
<div class="row"><button id="exportImgs" class="primary" data-i="export_pages">Esporta pagine</button></div><div id="pdfImgStatus" class="status"></div>
</div></section>

<section class="panel" id="merge"><div class="head"><button class="back">←</button><strong data-i="t_merge">Unisci PDF</strong></div><div class="body"><div class="drop"><label class="pick"><span data-i="choose_pdfs">Scegli PDF</span><input id="mergeInput" type="file" accept="application/pdf,.pdf" multiple></label></div><div id="mergeList" class="fileList"></div><div class="row"><button id="mergeBtn" class="primary" data-i="merge_now">Unisci</button><button id="mergeClear" class="secondary" data-i="clear">Svuota</button></div><div id="mergeStatus" class="status"></div></div></section>

<section class="panel" id="extract"><div class="head"><button class="back">←</button><strong data-i="t_extract">Estrai pagine</strong></div><div class="body"><div class="drop"><label class="pick"><span data-i="choose_pdf">Scegli PDF</span><input id="extractInput" type="file" accept="application/pdf,.pdf"></label></div><div class="row"><div class="field"><label class="cap" data-i="pages_keep">Pagine da conservare</label><input id="extractSpec" type="text" placeholder="1,3,5-8"></div></div><div class="hint" data-i="ranges_help">Esempio: 1,4-7,10</div><div class="row"><button id="extractBtn" class="primary" data-i="extract_now">Crea PDF estratto</button></div><div id="extractStatus" class="status"></div></div></section>

<section class="panel" id="organize"><div class="head"><button class="back">←</button><strong data-i="t_org">Organizza PDF</strong></div><div class="body"><div class="drop"><label class="pick"><span data-i="choose_pdf">Scegli PDF</span><input id="orgInput" type="file" accept="application/pdf,.pdf"></label></div><div id="orgGrid" class="previewGrid"></div><div class="row"><button id="orgSave" class="primary" data-i="save_pdf">Salva nuovo PDF</button></div><div id="orgStatus" class="status"></div></div></section>

<section class="panel" id="sign"><div class="head"><button class="back">←</button><strong data-i="t_sign">Firma PDF</strong></div><div class="body"><div class="drop"><label class="pick"><span data-i="choose_pdf">Scegli PDF</span><input id="signInput" type="file" accept="application/pdf,.pdf"></label></div><div class="row"><div class="field"><label class="cap" data-i="page">Pagina</label><input id="signPage" type="number" min="1" value="1"></div><div class="field"><label class="cap"><span data-i="signature_width">Larghezza firma</span> <span id="sigWVal">32%</span></label><input id="sigW" type="range" min="12" max="60" value="32"></div></div><label class="cap" data-i="draw_sig">Disegna la firma</label><canvas id="sigCanvas" class="sig" width="900" height="320"></canvas><div class="row"><button id="sigClear" class="secondary" data-i="clear_sig">Cancella firma</button></div><div class="hint" data-i="tap_sig">Tocca l’anteprima per posizionare la firma. Poi trascinala o usa le frecce per riposizionarla con precisione.</div><div class="previewWrap" style="margin-top:10px"><div class="editStage" id="signStage"><canvas id="signPreview"></canvas><img id="signOverlay" class="editorOverlay sigOverlay" draggable="false" alt=""></div></div><div class="nudgeRow" id="signNudges"><button type="button" data-nudge="left" aria-label="Sposta a sinistra">←</button><button type="button" data-nudge="up" aria-label="Sposta in alto">↑</button><button type="button" data-nudge="center" aria-label="Centra">⊙</button><button type="button" data-nudge="down" aria-label="Sposta in basso">↓</button><button type="button" data-nudge="right" aria-label="Sposta a destra">→</button></div><div class="row"><button id="signSave" class="primary" data-i="apply_save">Applica e salva</button></div><div id="signStatus" class="status"></div></div></section>

<section class="panel" id="text"><div class="head"><button class="back">←</button><strong data-i="t_text">Aggiungi testo</strong></div><div class="body"><div class="drop"><label class="pick"><span data-i="choose_pdf">Scegli PDF</span><input id="textInput" type="file" accept="application/pdf,.pdf"></label></div><div class="row"><div class="field"><label class="cap" data-i="text_label">Testo</label><input id="stampText" type="text"></div><button id="todayBtn" class="secondary" data-i="today">Data di oggi</button></div><div class="row"><div class="field"><label class="cap" data-i="page">Pagina</label><input id="textPage" type="number" min="1" value="1"></div><div class="field"><label class="cap" data-i="size">Dimensione</label><input id="textSize" type="number" min="6" max="72" value="14"></div></div><div class="hint" data-i="tap_text">Tocca l’anteprima per posizionare il testo. Comparirà subito: trascinalo o usa le frecce per riposizionarlo.</div><div class="previewWrap" style="margin-top:10px"><div class="editStage" id="textStage"><canvas id="textPreview"></canvas><div id="textOverlay" class="editorOverlay textOverlay"></div></div></div><div class="nudgeRow" id="textNudges"><button type="button" data-nudge="left" aria-label="Sposta a sinistra">←</button><button type="button" data-nudge="up" aria-label="Sposta in alto">↑</button><button type="button" data-nudge="center" aria-label="Centra">⊙</button><button type="button" data-nudge="down" aria-label="Sposta in basso">↓</button><button type="button" data-nudge="right" aria-label="Sposta a destra">→</button></div><div class="row"><button id="textSave" class="primary" data-i="add_save">Aggiungi e salva</button></div><div id="textStatus" class="status"></div></div></section>

<section class="panel" id="compress"><div class="head"><button class="back">←</button><strong data-i="t_comp">Comprimi scansione</strong></div><div class="body"><div class="drop"><label class="pick"><span data-i="choose_pdf">Scegli PDF</span><input id="compInput" type="file" accept="application/pdf,.pdf"></label></div><div class="row"><div class="field"><label class="cap" data-i="profile">Profilo</label><select id="compScale"><option value="1" data-i="very_light">Molto leggero</option><option value="1.35" selected data-i="balanced">Bilanciato</option><option value="1.8" data-i="sharper">Più nitido</option></select></div><div class="field"><label class="cap"><span data-i="quality">Qualità JPG</span> <span id="compQVal">68%</span></label><input id="compQ" type="range" min="35" max="90" value="68"></div></div><div class="hint" data-i="comp_warn">Adatto soprattutto a scansioni: il testo verrà rasterizzato e non resterà selezionabile.</div><div class="row"><button id="compBtn" class="primary" data-i="compress_now">Comprimi</button></div><div id="compStatus" class="status"></div></div></section>

<div class="footer">PDF Semplice / Simple PDF — browser-first validation build V5</div>
</div>
