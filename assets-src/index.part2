appear immediately: drag it or use the arrows to reposition it.',add_save:'Add and save',profile:'Profile',very_light:'Very light',balanced:'Balanced',sharper:'Sharper',comp_warn:'Best for scans: text will be rasterized and will no longer be selectable.',compress_now:'Compress',file_selected:'File selected',pages:'pages',page_word:'page',loading:'Loading…',working:'Processing…',created:'File created.',select_image:'Select at least one image.',select_pdf:'Select a PDF.',select_two:'Select at least two PDFs.',preview_ready:'Preview ready.',whole_image:'✓ Whole image: no cropping',will_crop:'⚠ Part of the image will be cropped',exported:'Pages exported',invalid_pdf:'PDF cannot be read or is protected.',download_blocked:'The browser blocked the download. Check download permissions.',error:'Error',no_pages:'No valid pages.',sig_missing:'Draw the signature first.',tap_missing:'Tap a point in the preview first.',text_missing:'Enter the text first.',saved:'Saved.'}};
const tr=k=>T[LANG][k]||k;
function applyLang(){document.documentElement.lang=LANG;$$('[data-i]').forEach(el=>{const k=el.dataset.i;if(T[LANG][k])el.textContent=T[LANG][k]});$('#itBtn').classList.toggle('on',LANG==='it');$('#enBtn').classList.toggle('on',LANG==='en');checkEngines();}
$('#itBtn').onclick=()=>{LANG='it';try{localStorage.setItem('pdfsemplice_lang',LANG)}catch(e){}applyLang()};$('#enBtn').onclick=()=>{LANG='en';try{localStorage.setItem('pdfsemplice_lang',LANG)}catch(e){}applyLang()};
function status(id,msg,type='info'){const e=$(id);e.textContent=msg;e.className='status show '+type}function clearStatus(id){const e=$(id);e.className='status';e.textContent=''}
function fmt(n){if(n<1024)return n+' B';if(n<1048576)return (n/1024).toFixed(1)+' KB';return (n/1048576).toFixed(1)+' MB'}
function basename(name){return (name||'document').replace(/\.[^.]+$/,'').replace(/[^\wÀ-ÿ .-]+/g,'_').trim()||'document'}
function download(blobOrBytes,name,type='application/octet-stream'){const blob=blobOrBytes instanceof Blob?blobOrBytes:new Blob([blobOrBytes],{type});const a=document.createElement('a');const url=URL.createObjectURL(blob);a.href=url;a.download=name;a.style.display='none';document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(url);a.remove()},2500)}
function move(arr,i,d,cb){const j=i+d;if(j<0||j>=arr.length)return;[arr[i],arr[j]]=[arr[j],arr[i]];cb()}
function checkEngines(){const ok=!!(window.PDFLib&&window.pdfjsLib&&window.JSZip);$('#engineDot').className='dot '+(ok?'ok':'bad');$('#engineText').textContent=tr(ok?'engine_ok':'engine_bad');return ok}
// Configure PDF.js worker from embedded source. If that fails, pdf.js falls back to its fake worker.
(function(){try{pdfjsLib.GlobalWorkerOptions.workerSrc='libs/pdf.worker.min.js'}catch(e){console.warn(e)}})();
function openPanel(id){$('#home').style.display='none';$$('.panel').forEach(p=>p.classList.remove('active'));$('#'+id).classList.add('active');scrollTo(0,0)}function home(){ $$('.panel').forEach(p=>p.classList.remove('active'));$('#home').style.display='block';scrollTo(0,0)}$$('[data-open]').forEach(b=>b.onclick=()=>openPanel(b.dataset.open));$$('.back').forEach(b=>b.onclick=home);
async function loadPdfJS(fileOrBytes){const data=fileOrBytes instanceof File?new Uint8Array(await fileOrBytes.arrayBuffer()):fileOrBytes;return await pdfjsLib.getDocument({data}).promise}
async function renderPage(pdf,n,canvas,scale=1.4){const page=await pdf.getPage(n),vp=page.getViewport({scale});canvas.width=Math.ceil(vp.width);canvas.height=Math.ceil(vp.height);await page.render({canvasContext:canvas.getContext('2d'),viewport:vp}).promise;return {page,vp}}
const canvasBlob=(c,t='image/jpeg',q=.88)=>new Promise((res,rej)=>c.toBlob(b=>b?res(b):rej(new Error('Canvas export failed')),t,q));
async function imageToCanvas(item,max=3000){const url=URL.createObjectURL(item.file);try{const img=await new Promise((res,rej)=>{const im=new Image();im.onload=()=>res(im);im.onerror=()=>rej(new Error('Image decode failed'));im.src=url});const rot=((item.rot||0)%360+360)%360,swap=rot===90||rot===270,ow=swap?img.naturalHeight:img.naturalWidth,oh=swap?img.naturalWidth:img.naturalHeight,k=Math.min(1,max/Math.max(ow,oh));const c=document.createElement('canvas');c.width=Math.max(1,Math.round(ow*k));c.height=Math.max(1,Math.round(oh*k));const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.save();x.translate(c.width/2,c.height/2);x.rotate(rot*Math.PI/180);x.drawImage(img,-img.naturalWidth*k/2,-img.naturalHeight*k/2,img.naturalWidth*k,img.naturalHeight*k);x.restore();return c}finally{URL.revokeObjectURL(url)}}
function pageSpec(sw,sh){const mode=$('#imgPageSize').value,ori=$('#imgOrientation').value;if(mode==='image'){const max=841.89,k=max/Math.max(sw,sh);return {w:sw*k,h:sh*k,m:0}}const land=ori==='landscape'||(ori==='auto'&&sw>sh);return {w:land?841.89:595.28,h:land?595.28:841.89,m:+$('#imgMargin').value*72/25.4}}
function placement(sw,sh,pw,ph,m,mode){const aw=Math.max(1,pw-2*m),ah=Math.max(1,ph-2*m),k=mode==='cover'?Math.max(aw/sw,ah/sh):Math.min(aw/sw,ah/sh),w=sw*k,h=sh*k;return {x:(pw-w)/2,y:(ph-h)/2,w,h,crop:mode==='cover'&&(w>aw+.1||h>ah+.1)}}

let imgs=[];$('#imgInput').onchange=e=>{imgs.push(...[...e.target.files].map(file=>({file,rot:0})));e.target.value='';renderImgPreviews()};$('#imgMargin').oninput=e=>{$('#marginVal').textContent=e.target.value+' mm';renderImgPreviews()};$('#imgQ').oninput=e=>$('#imgQVal').textContent=e.target.value+'%';['#imgPageSize','#imgOrientation','#imgFit'].forEach(s=>$(s).onchange=renderImgPreviews);$('#safeFit').onclick=()=>{$('#imgFit').value='contain';renderImgPreviews()};$('#clearImgs').onclick=()=>{imgs=[];$('#imgPreview').innerHTML='';clearStatus('#imgStatus')};
async function renderImgPreviews(){const g=$('#imgPreview');g.innerHTML='';if(!imgs.length)return;status('#imgStatus',tr('loading'),'info');for(let i=0;i<imgs.length;i++){const it=imgs[i],card=document.createElement('div');card.className='pageCard';const c=document.createElement('canvas'),meta=document.createElement('div'),note=document.createElement('div'),mini=document.createElement('div');mini.className='mini';mini.innerHTML='<button data-a="up">↑</button><button data-a="down">↓</button><button data-a="l">↶</button><button data-a="r">↷</button><button data-a=